<Instruction
	RtName="script_BuildOutputString"
	RtType="5"
	RtId="180270480"
	ParentInstr="0"
	InstrType="14"
	Collapsed="0"
	ScriptCode="// ------------------------   helper functions &#xD;function Trace(str) {&#xD;	if (Vars.TracerOn)&#xD;		VEngine.Reporter(str);&#xD;}&#xD;&#xD;function BoolToNumber(val) {&#xD;	if (val) {&#xD;		return 1;&#xD;	} else {&#xD;		return 0;&#xD;	}&#xD;}&#xD;&#xD;function ToPLCNumber(val) {&#xD;	Trace(&apos;ToPLCNumber input &apos; + val);&#xD;		if (val * Vars.PLC_CONVERTION_FACTOR &gt; Vars.MAX_NUMBER_PLC ) {&#xD;			val = (Vars.MAX_NUMBER_PLC / Vars.PLC_CONVERTION_FACTOR)&#xD;			}; &#xD;		/* - &#xD;		if (val * Vars.PLC_CONVERTION_FACTOR &lt; -1*Vars.MAX_NUMBER_PLC ) {&#xD;			val = -1*(Vars.MAX_NUMBER_PLC / Vars.PLC_CONVERTION_FACTOR)&#xD;			};&#xD;		*/	&#xD;	//prevent negative values in output telegramm, negative values are not valid&#xD;		if (val &lt; 0) {&#xD;			val = 0&#xD;			};&#xD;&#xD;	val = val * Vars.PLC_CONVERTION_FACTOR; &#xD;	val = Math.round(val);  &#xD;	//val = parseInt(val); &#xD;	Trace(&apos;ToPLCNumber output &apos; + val.toString());&#xD;	return val.toString(); &#xD;	}&#xD;&#xD;function PointsArrayToString(pointsCount, pts) {&#xD;	s = &apos;&apos;;&#xD;	for (i=0;i&lt;pointsCount;i++) {&#xD;		s += Vars.LIST_SEPARATOR + ToPLCNumber(pts[i].x) + Vars.LIST_SEPARATOR + ToPLCNumber(pts[i].y);&#xD;	}&#xD;	Trace(&apos;PointsArrayToString output &apos; + s);&#xD;&#xD;	return s;&#xD;}&#xD;&#xD;function NumbersArrayToString(nmbrs, nmbrsCount) {&#xD;	s = &apos;&apos;;&#xD;	for (i=0;i&lt;nmbrsCount;i++) {&#xD;    if (s != &quot;&quot;) {&#xD;      s += Vars.LIST_SEPARATOR;&#xD;    }&#xD;		s += ToPLCNumber(nmbrs[i]);&#xD;	}&#xD;	Trace(&apos;NumbersArrayToString output &apos; + s);&#xD;&#xD;	return s;&#xD;}&#xD;&#xD;//    ------------- &#xD;// -------------------  MAIN function ----------------------------- &#xD;//    ------------- &#xD;&#xD;try {&#xD;	Trace(&apos;output builder&apos;);&#xD;	if (Vars.MeasurementError != &quot;&quot;) {&#xD;		Vars.telegram_type = &quot;exe_err&quot;;&#xD;	}&#xD;	&#xD;	switch(Vars.telegram_type) {&#xD;	&#xD;	case Vars.cmd_dia_seq_circ:&#xD;		Vars.output = &quot;dia&quot; + Vars.COMMAND_SEPARATOR;&#xD;		Vars.output += NumbersArrayToString(Vars.output_numbers, 10);				//10 numbers&#xD;		Vars.output += PointsArrayToString(2, Vars.output_points);							//2 points&#xD;	break;&#xD;&#xD;	case Vars.cmd_dipping:&#xD;		Vars.output = &quot;dip&quot; + Vars.COMMAND_SEPARATOR;&#xD;		Vars.output += NumbersArrayToString(Vars.output_numbers, 1);				//1 number&#xD;	break;&#xD;	&#xD;	case Vars.cmd_melting:&#xD;		Vars.output = &quot;mlt&quot; + Vars.COMMAND_SEPARATOR;&#xD;		Vars.output += NumbersArrayToString(Vars.output_numbers, 7);				//7 numbers&#xD;	break;&#xD;   &#xD;   case Vars.cmd_dia_ROI_coord_change:&#xD;	case Vars.cmd_s_cam1_rake_ROI_coord_change:&#xD;   case Vars.cmd_s_cam2_rake_ROI_coord_change:&#xD;	case Vars.cmd_dia_ROI_threshold_change:&#xD;	case Vars.cmd_dip_ROI_coord_change: &#xD;	case Vars.cmd_dip_ROI_threshold_change: &#xD;	case Vars.cmd_melt_ROI_coord_change: &#xD;	case Vars.cmd_melt_ROI_threshold_change:&#xD;	case Vars.cmd_image_acquisition_on:&#xD;	case Vars.cmd_image_acquisition_off: &#xD;	case Vars.cmd_dia_ROI_thr_abs_type:&#xD;	case Vars.cmd_dia_ROI_thr_rel_type:&#xD;	case Vars.cmd_s_cam_circ_fit:&#xD;	case Vars.cmd_s_cam_avg_pt_fit:&#xD;	case Vars.cmd_SetRefreshRate:&#xD;		//send back result&#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR + Vars.output;&#xD;	break;&#xD;&#xD;	case Vars.cmd_image_acquisition_get: &#xD;		//send back result&#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR + Vars.param_MeasurementEnabled;&#xD;	break;&#xD;&#xD;//diameter measurement with partial spoke&#xD;//-----------------------------------------------------------	&#xD;case Vars.cmd_dia_get_properties: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add threshold type&#xD;		Vars.output += ToPLCNumber(BoolToNumber(Vars.param_enable_threshold_by_persent)) + Vars.LIST_SEPARATOR;&#xD;		// add threshold&#xD;		Vars.output += ToPLCNumber(Vars.param_dia_ROI_threshold);&#xD;		// add coords&#xD;		Vars.output += PointsArrayToString(4, Vars.param_dia_ROI_coord);&#xD;	break;&#xD;	&#xD;//camera 1 of diameter measurement with rake&#xD;	case Vars.cmd_s_cam1_rake_get_properties: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add threshold type&#xD;		Vars.output += ToPLCNumber(BoolToNumber(Vars.param_enable_threshold_by_persent)) + Vars.LIST_SEPARATOR;&#xD;		// add threshold&#xD;		Vars.output += ToPLCNumber(Vars.param_dia_ROI_threshold);&#xD;		// add coords&#xD;		Vars.output += PointsArrayToString(2, Vars.param_s_cam1_rake_ROI_coord);&#xD;	break;&#xD;&#xD;	//camera 2 of diameter measurement with rake&#xD;	case Vars.cmd_s_cam2_rake_get_properties: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add threshold type&#xD;		Vars.output += ToPLCNumber(BoolToNumber(Vars.param_enable_threshold_by_persent)) + Vars.LIST_SEPARATOR;&#xD;		// add threshold&#xD;		Vars.output += ToPLCNumber(Vars.param_dia_ROI_threshold);&#xD;		// add coords&#xD;		Vars.output += PointsArrayToString(2, Vars.param_s_cam2_rake_ROI_coord);&#xD;	break;&#xD;&#xD;	//camera 1 of dipping detection&#xD;   case Vars.cmd_dip_get_properties: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add threshold&#xD;		Vars.output += ToPLCNumber(Vars.param_dip_ROI_threshold);&#xD;		// add coords&#xD;		Vars.output += PointsArrayToString(2, Vars.param_dip_ROI_coord);&#xD;	break;&#xD;&#xD;	//camera 1 of melting detection&#xD;	case Vars.cmd_melt_get_properties: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add threshold&#xD;		Vars.output += ToPLCNumber(Vars.param_melt_ROI_threshold);&#xD;		// add coords&#xD;		Vars.output += PointsArrayToString(2, Vars.param_melt_ROI_coord);&#xD;	break;&#xD;&#xD;	case Vars.cmd_get_version: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add program version&#xD;		Vars.output += ToPLCNumber(Vars.version);&#xD;	break;&#xD;&#xD;	case Vars.cmd_GetRefreshRate: &#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR;&#xD;		// add program version&#xD;		Vars.output += ToPLCNumber(Vars.refresh_rate);&#xD;	break;&#xD;&#xD;	default:&#xD;		Vars.output = Vars.telegram_type + Vars.COMMAND_SEPARATOR + Vars.output;&#xD;		ss = Vars.InputString_from_PLC;&#xD;		// replace CRLF with &lt;CR&gt;&lt;LF&gt;&#xD;		re2 = /\n/g;&#xD;		ss = ss.replace(re2, &quot;&lt;CR&gt;&quot;);&#xD;		re2 = /\r/g;&#xD;		ss = ss.replace(re2, &quot;&lt;LF&gt;&quot;);&#xD;&#xD;		Vars.output += Vars.LIST_SEPARATOR + ss;&#xD;	}	&#xD;	Trace(&apos;output - EOL &apos; + Vars.output);&#xD;&#xD;	// append command identifyer &amp; next to bytes(symbols): max &amp; actual string length ( +2 means for CRLF) &#xD;	if (Vars.output.length != 90){&#xD;		Vars.output =  Vars.PLC_CMD_START_SYMBOL + String.fromCharCode(Vars.MAX_PLC_STRING_LENGTH) + String.fromCharCode(Vars.output.length + 2) + Vars.output;&#xD;		// append CRLF&#xD;		Vars.output +=  &quot;\r&quot; + &quot;\n&quot;		//CRLF termintates the output string&#xD;	}	&#xD;// append command identifyer &amp; next to bytes(symbols): max &amp; actual string length ( +3 means for CRLFLF) - workaround to prevent a string length of 90 + 2 characters, 92dez &gt; \ as ascii, backslash is not valid in PLC string variable&#xD;	else{&#xD;		Vars.output =  Vars.PLC_CMD_START_SYMBOL + String.fromCharCode(Vars.MAX_PLC_STRING_LENGTH) + String.fromCharCode(Vars.output.length + 3) + Vars.output&#xD;		// append CRLF&#xD;		Vars.output +=  &quot;\r&quot; + &quot;\n&quot; + &quot;\n&quot;		//CRLFLF termintates the output string&#xD;		}&#xD;}&#xD;finally {&#xD;	Trace(&apos;output: &apos; + Vars.output);&#xD;}&#xD;&#xD;&#xD;/*&#xD;re2 = /=/g;&#xD;VEngine.Reporter(src.match(re2));&#xD;while ((arr = re2.exec(src)) != null) {&#xD;   VEngine.Reporter(arr.index + &quot;-&quot; + arr.lastIndex + &quot;\t&quot; + arr);&#xD;}&#xD;&#xD;re = new RegExp(src, &quot;\n&quot;);&#xD;VEngine.Reporter(&apos;ku-ku&apos;);&#xD;&#xD;while ((arr = re.exec(src)) != null) {&#xD;VEngine.Reporter(&apos;ku-ku&apos;);&#xD;   VEngine.Reporter(arr.index + &quot;-&quot; + arr.lastIndex + &quot;\t&quot; + arr);&#xD;}&#xD;;&#xD;*/">
<Inputs
/>
<Outputs
/>
<Params
/>
</Instruction>
