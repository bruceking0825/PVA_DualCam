<Instruction
	RtName="script_InitVars"
	RtType="5"
	RtId="180271640"
	ParentInstr="0"
	InstrType="14"
	Collapsed="0"
	ScriptCode="//generell functions&#xD;function DegToRad(Angle){&#xD;	return(Math.PI * Angle/180);&#xD;	}&#xD;&#xD;// camera parameters&#xD;Vars.exposure_time =3000;  //unit is micro seconds&#xD;Vars.refresh_rate = 1; // count measurements to skip befor picture redraw&#xD;&#xD;// TCP string constants&#xD;//	string terminator - End Of Line&#xD;Vars.EOL = &quot;\r&quot;;		//früher &quot;\n&quot; in Sherlock 7.1.x.x als end of line character &#xD;//	items saparator&#xD;Vars.LIST_SEPARATOR = &quot;;&quot;;&#xD;//	command separator&#xD;Vars.COMMAND_SEPARATOR = &quot;=&quot;;&#xD;//	command starting symbol&#xD;Vars.PLC_CMD_START_SYMBOL = &quot;!&quot;;&#xD;//	max number for/from PLC&#xD;Vars.MAX_NUMBER_PLC = 999900;&#xD;// max string length in PLC&#xD;Vars.MAX_PLC_STRING_LENGTH = 255; &#xD;// because communication with PLC uses integer numbers&#xD;//   hence floating point values will be mult with FACTOR and rounded&#xD;Vars.PLC_CONVERTION_FACTOR = 100;&#xD;&#xD;//stereo camera variables&#xD;Vars.s_cam_rake_elements = 30;		//Anzahl der Messlinien im Rake ROI&#xD;Vars.rake_width = 60								//feste Breite des Rake ROI in pixel (erscheint im Bild als Höhe)&#xD;&#xD;alpha = 26.25;	//Winkel (deg) zwischen vertikaler Ziehachse und Mittelachse zwischen zwei Kameras&#xD;beta = 2.75;		//Paralaxenwinkel (deg)&#xD;&#xD;&#xD;//convert angles from degree to radiant&#xD;alpha_rad	= DegToRad(alpha);&#xD;beta_rad	= DegToRad(beta);&#xD;&#xD;//calculate trigonometric terms&#xD;Vars.term1 = Math.sin(alpha_rad - beta_rad);&#xD;Vars.term2 = Math.sin(alpha_rad + beta_rad);&#xD;Vars.term3 = Math.cos(alpha_rad - beta_rad);&#xD;Vars.term4 = Math.cos(alpha_rad + beta_rad);&#xD;&#xD;// program version&#xD;Vars.version = &quot;4.14&quot;;">
<Inputs
/>
<Outputs
/>
<Params
/>
</Instruction>
