<Instruction
	RtName="script_ParseInput"
	RtType="5"
	RtId="180265840"
	ParentInstr="0"
	InstrType="14"
	Collapsed="0"
	ScriptCode="// ------------------------   helper functions&#xD;function Trace(str) {&#xD;	if (Vars.TracerOn)&#xD;		VEngine.Reporter(str);&#xD;}&#xD;&#xD;function isNumber(str) {&#xD;	tst = str;&#xD;&#xD;	val = tst - 10.0;&#xD;	val = val + 10.0;&#xD;&#xD;	// zero value is something strange: 0 is NOT = 0!!!!!&#xD;	if (val != 0)			&#xD;		isNum = (tst = val);&#xD;	else&#xD;		isNum = true;&#xD;&#xD;	if (! isNum) {&#xD;		Vars.telegram_type = &quot;err_prm&quot;;&#xD;		Vars.output = &apos;&quot;&apos; + str + &apos;&quot; is not a number&apos;;&#xD;		Trace(&apos;wrong parameter: &apos; + Vars.output);					&#xD;	}&#xD;	return isNum;&#xD;}&#xD;&#xD;function ToNumber(str) {&#xD;  if ((str &lt; Vars.MAX_NUMBER_PLC) &amp;&amp; (str &gt; -1*Vars.MAX_NUMBER_PLC)) {&#xD;    str = str / Vars.PLC_CONVERTION_FACTOR;	&#xD;  } else {&#xD;    str = Vars.MAX_NUMBER_PLC / Vars.PLC_CONVERTION_FACTOR;&#xD;  }  &#xD;&#xD;  return str;&#xD;}&#xD;function StringsToPointsArray(str, pointsCount, pts) {&#xD;	ss = str.split(Vars.LIST_SEPARATOR);&#xD;&#xD;	if (ss.length != (pointsCount * 2)) {&#xD;		Vars.telegram_type = &quot;err_prm&quot;;&#xD;		Vars.output = &quot;ROI need &quot; + (pointsCount * 2).toString() + &quot; params, got &quot; + ss.length;&#xD;		Trace(&apos;wrong parameters count: &apos; + Vars.output);		&#xD;		return false;&#xD;	} else {&#xD;		for (i=0;i&lt;pointsCount;i++) {&#xD;			if (! isNumber(ss[2*i])) {&#xD;				return false;&#xD;			}&#xD;			if (! isNumber(ss[2*i+1])) {&#xD;				return false;&#xD;			}&#xD;		}&#xD;		for (i=0;i&lt;pointsCount;i++) {&#xD;			pts[i].x = ToNumber(ss[2*i]);&#xD;			pts[i].y = ToNumber(ss[2*i+1]);&#xD;		}&#xD;		return true;&#xD;	}&#xD;}&#xD;function StringsToNumbersArray(str, numbersCount, nrs) {&#xD;	ss = str.split(Vars.LIST_SEPARATOR);&#xD;&#xD;	if (ss.length != (numbersCount)) {&#xD;		Vars.telegram_type = &quot;err_prm&quot;;&#xD;		Vars.output = &quot;ROI need &quot; + (numbersCount).toString() + &quot; params, got &quot; + ss.length;&#xD;		Trace(&apos;wrong parameters count: &apos; + Vars.output);		&#xD;		return false;&#xD;	} else {&#xD;		for (i=0;i&lt;numbersCount;i++) {&#xD;			if (! isNumber(ss[i])) {&#xD;				return false;&#xD;			}&#xD;		}&#xD;		for (i=0;i&lt;numbersCount;i++) {&#xD;			nrs[i] = ToNumber(ss[i]);&#xD;		}&#xD;		return true;&#xD;	}&#xD;}&#xD;&#xD;function DegToRad(Angle) {&#xD;	return (Math.PI * Angle/180);&#xD;}&#xD;&#xD;function ConvertDiameterBoundBoxToROICoords(nrs, pts) {&#xD;  centerX = nrs[0];	&#xD;  centerY = nrs[1];	&#xD;  bAngle  = 90 + nrs[2];	&#xD;  eAngle  = 90 + nrs[3];	&#xD;  iRadius = nrs[4];	&#xD;  oRadius = nrs[5];	&#xD;&#xD;&#xD;  alpha = DegToRad(bAngle);&#xD;  pts[1].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[1].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;  alpha = DegToRad(eAngle);&#xD;  pts[0].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[0].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;&#xD;  alpha = DegToRad(eAngle + bAngle)/2;&#xD;  pts[2].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[2].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;  pts[3].x = Math.round( centerX + iRadius * Math.cos(alpha));&#xD;  pts[3].y = Math.round( centerY + iRadius * Math.sin(alpha));	&#xD;}&#xD;&#xD;function ConvertDiameterBoundBox_2_ToROICoords(nrs, pts) {&#xD;  centerX = nrs[0] + nrs[6];			//add x- offset to center point x&#xD;  centerY = nrs[1]+ nrs[7];			//add y- offset to center point y&#xD;  bAngle  = 90 + nrs[2];	&#xD;  eAngle  = 90 + nrs[3];	&#xD;  iRadius = nrs[4];	&#xD;  oRadius = nrs[5];	&#xD;&#xD;&#xD;  alpha = DegToRad(bAngle);&#xD;  pts[1].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[1].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;  alpha = DegToRad(eAngle);&#xD;  pts[0].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[0].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;&#xD;  alpha = DegToRad(eAngle + bAngle)/2;&#xD;  pts[2].x = Math.round( centerX + oRadius * Math.cos(alpha));&#xD;  pts[2].y = Math.round( centerY + oRadius * Math.sin(alpha));&#xD;  pts[3].x = Math.round( centerX + iRadius * Math.cos(alpha));&#xD;  pts[3].y = Math.round( centerY + iRadius * Math.sin(alpha));	&#xD;}&#xD;&#xD;function ConvertDiaRectBoundBoxToROICoords (nrs, pts) {&#xD;   centerX = nrs[0] - nrs[4] - (nrs[5] - nrs[4]) / 2;	//(x- partial spoke) - (inner radius) - (outer radius - inner radius) / 2	&#xD;   centerY = nrs[1];														//y- partial spoke&#xD;	height   = nrs[5] - nrs[4];											//outer radius - inner radius &gt;&gt;rake is rotated 90°, that means height and width are exchanged&#xD;	width  	= Vars.rake_width;									//fixed value (configured in startup script)&#xD;&#xD;  pts[0].x = Math.round( centerX -  width/2);&#xD;  pts[0].y = Math.round( centerY - height/2);&#xD;  pts[1].x = Math.round( centerX +  width/2);&#xD;  pts[1].y = Math.round( centerY + height/2);&#xD;}&#xD;&#xD;function ConvertDiaRectBoundBox_2_ToROICoords (nrs, pts) {&#xD;  centerX = nrs[0] - nrs[4] + nrs[6] - (nrs[5] - nrs[4]) / 2;		//(x- partial spoke) - (inner radius) + (x- offset cam2) - (outer radius - inner radius) / 2	&#xD;  centerY = nrs[1] + nrs[7]																//y- partial spoke + y- offset cam2&#xD;  height   = nrs[5] - nrs[4];																//outer radius - inner radius &gt;&gt;rake is rotated 90°, that means height and width are exchanged&#xD;  width   = Vars.rake_width;															//fixed value  (configured in startup script)&#xD;&#xD;  pts[0].x = Math.round( centerX -  width/2);&#xD;  pts[0].y = Math.round( centerY - height/2);&#xD;  pts[1].x = Math.round( centerX +  width/2);&#xD;  pts[1].y = Math.round( centerY + height/2);&#xD;}&#xD;&#xD;function ConvertMeltVibrationBoundBoxToROICoords (nrs, pts) {&#xD;  centerX = nrs[0];	&#xD;  centerY = nrs[1];	&#xD;  width   = nrs[2];	&#xD;&#xD;  pts[0].x = Math.round( centerX - width/2);&#xD;  pts[0].y = Math.round( centerY);&#xD;  pts[1].x = Math.round( centerX + width/2);&#xD;  pts[1].y = Math.round( centerY);&#xD;}&#xD;&#xD;function ConvertDippingBoundBoxToROICoords (nrs, pts) {&#xD;  centerX = nrs[0];	&#xD;  centerY = nrs[1];	&#xD;  width   = nrs[2];	&#xD;&#xD;  pts[0].x = Math.round( centerX - width/2);&#xD;  pts[0].y = Math.round( centerY);&#xD;  pts[1].x = Math.round( centerX + width/2);&#xD;  pts[1].y = Math.round( centerY);&#xD;}&#xD;&#xD;function ConvertMeltingBoundBoxToROICoords (nrs, pts) {&#xD;  centerX = nrs[0];	&#xD;  centerY = nrs[1];	&#xD;  width   = nrs[2];	&#xD;  height  = nrs[3];	&#xD;&#xD;  pts[0].x = Math.round( centerX -  width/2);&#xD;  pts[0].y = Math.round( centerY - height/2);&#xD;  pts[1].x = Math.round( centerX +  width/2);&#xD;  pts[1].y = Math.round( centerY + height/2);&#xD;}&#xD;&#xD;function ConvertMeltingBoundBox_2_ToROICoords (nrs, pts) {&#xD;  centerX = nrs[0] + nrs[4];		//add x- offset to center point x&#xD;  centerY = nrs[1] + nrs[5];	//add y- offset to center point y&#xD;  width   = nrs[2];	&#xD;  height  = nrs[3];	&#xD;&#xD;  pts[0].x = Math.round( centerX -  width/2);&#xD;  pts[0].y = Math.round( centerY - height/2);&#xD;  pts[1].x = Math.round( centerX +  width/2);&#xD;  pts[1].y = Math.round( centerY + height/2);&#xD;}&#xD;&#xD;//    -------------&#xD;// -------------------  MAIN function -----------------------------&#xD;//    -------------&#xD;&#xD;try {&#xD;	if (! Vars.TCP_receiving_successful) {&#xD;		Vars.telegram_type = &quot;&quot;;&#xD;	}&#xD;	else {&#xD;		try {&#xD;		Trace(&apos;input &apos; + Vars.InputString_from_PLC);&#xD;		ss = Vars.InputString_from_PLC;&#xD;      // check command identifyer&#xD;//     if (ss[0] != Vars.PLC_CMD_START_SYMBOL) {&#xD;//VEngine.Reporter(&apos;input [0]&apos; + ss[1]);&#xD;//         throw &quot;PLC Command start symbol not found&quot;;&#xD;//      }  &#xD;      &#xD;      // remove command identifyer &amp; next to bytes(symbols) - max &amp; actual string length&#xD;//      ss = ss.slice(3);&#xD;			// remove CRLF&#xD;			re2 = /\n/g;&#xD;			ss = ss.replace(re2, &quot;&quot;);&#xD;			re2 = /\r/g;&#xD;			ss = ss.replace(re2, &quot;&quot;);&#xD;&#xD;			ss = ss.split(Vars.COMMAND_SEPARATOR);&#xD;			cmd = ss[0];&#xD;			&#xD;			Trace(&apos;cmd &apos; + cmd);&#xD;			switch(cmd) {&#xD;			case Vars.cmd_dia_seq_circ:&#xD;			case Vars.cmd_dia_rect:&#xD;			case Vars.cmd_dipping:&#xD;			case Vars.cmd_melting:&#xD;				Vars.telegram_type = cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				if (!Vars.param_MeasurementEnabled) {&#xD;					Vars.telegram_type = &quot;err_lck&quot;;&#xD;					Vars.output = &quot;Measurement are disabled&quot;;&#xD;				}&#xD;	&#xD;				break;&#xD;			//stereo camera pic for the facet 1 2 3 4 &#xD;			case Vars.cmd_pic_fac1:&#xD;				Vars.telegram_type=cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				Vars.do_pic_fac1=true;&#xD;				break;	&#xD;			case Vars.cmd_pic_fac2:&#xD;				Vars.telegram_type=cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				Vars.do_pic_fac2=true;&#xD;				break;&#xD;			case Vars.cmd_pic_fac3:&#xD;				Vars.telegram_type=cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				Vars.do_pic_fac3=true;&#xD;				break;&#xD;			case Vars.cmd_pic_fac4:&#xD;				Vars.telegram_type=cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				Vars.do_pic_fac4=true;&#xD;				break;&#xD;&#xD;			case Vars.cmd_dia_get_properties:&#xD;		   case Vars.cmd_dia_rect_get_properties:&#xD;			case Vars.cmd_dip_get_properties:&#xD;			case Vars.cmd_melt_get_properties:&#xD;				Vars.telegram_type = cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;&#xD;				break;&#xD;&#xD;			//dia ROI change of coordinates (Partial spoke) - offset for cam2 is included in telegram string&#xD;			//------------------------------------------------------------------------------------------------------------------------------------&#xD;			case Vars.cmd_dia_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 8, Vars.inputNumbers)) {&#xD;					//partial spoke&#xD;					ConvertDiameterBoundBoxToROICoords(Vars.inputNumbers, Vars.param_dia_ROI_coord);&#xD;					ConvertDiameterBoundBox_2_ToROICoords(Vars.inputNumbers, Vars.param_dia_ROI_2_coord);&#xD;					//rake&#xD;					ConvertDiaRectBoundBoxToROICoords(Vars.inputNumbers, Vars.param_s_cam1_rake_ROI_coord);&#xD;					ConvertDiaRectBoundBox_2_ToROICoords(Vars.inputNumbers, Vars.param_s_cam2_rake_ROI_coord);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;&#xD;			break;&#xD;&#xD;			//dia ROI camera 1 change of threshold (Partial spoke)&#xD;			//----------------------------------------------------------------------------&#xD;			case Vars.cmd_dia_ROI_threshold_change: &#xD;				ss = ss[1];&#xD;&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_dia_ROI_threshold = ToNumber(ss);&#xD;					Vars.dia_thr = 255*Vars.param_dia_ROI_threshold/100;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				break;&#xD;&#xD;			//dia ROI camera 2 change of threshold (Partial spoke)&#xD;			//----------------------------------------------------------------------------&#xD;			case Vars.cmd_dia_ROI_sh_thr_cam_2_change: &#xD;				ss = ss[1];&#xD;&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_dia_ROI_sh_thr_cam_2 = ToNumber(ss);				&#xD;				   Vars.dia_sh_thr_cam_2 = 255*Vars.param_dia_ROI_sh_thr_cam_2/100;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				break;&#xD;&#xD;			//exposure time camera 1&#xD;			//-----------------------------------&#xD;			case Vars.cmd_exp_tme_cam_1_change: &#xD;				ss = ss[1];&#xD;&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_exp_tme_cam_1 = ToNumber(ss);&#xD;					Vars.exp_tme_cam_1 = Vars.exposure_time / 100 * Vars.param_exp_tme_cam_1;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				break;&#xD;&#xD;			//exposure time camera 2&#xD;			//-----------------------------------&#xD;			case Vars.cmd_exp_tme_cam_2_change: &#xD;				ss = ss[1];&#xD;&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_exp_tme_cam_2 = ToNumber(ss);&#xD;					Vars.exp_tme_cam_2 = Vars.exposure_time / 100 * Vars.param_exp_tme_cam_2;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				break;&#xD;&#xD;	&#xD;			//dia ROI change of coordinates (rectangle)&#xD;			//-----------------------------------------------------------		&#xD;			case Vars.cmd_dia_rect_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 4, Vars.inputNumbers)) {&#xD;					ConvertDiaRectBoundBoxToROICoords(Vars.inputNumbers, Vars.param_dia_rect_ROI_coord);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				break;&#xD;/*&#xD;			//stereo camera 1&#xD;			//-----------------------&#xD;			//ROI geometrie change of stereo camera Rakes&#xD;			case Vars.cmd_s_cam1_rake_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 4, Vars.inputNumbers)) {&#xD;					ConvertDiaRectBoundBoxToROICoords(Vars.inputNumbers, Vars.param_s_cam1_rake_ROI_coord);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;			break;&#xD;			&#xD;			//stereo camera 2&#xD;			//------------------------&#xD;			//ROI geometrie change of stereo camera Rakes&#xD;			case Vars.cmd_s_cam2_rake_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 4, Vars.inputNumbers)) {&#xD;					ConvertDiaRectBoundBoxToROICoords(Vars.inputNumbers, Vars.param_s_cam2_rake_ROI_coord);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;			break;&#xD;*/&#xD;			//stereo cameras in circle fit measurement mode&#xD;			case Vars.cmd_s_cam_circ_fit: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_enb_s_cam_circ_fit = true;&#xD;				Vars.output = &quot;ok&quot;;	&#xD;				break;&#xD;&#xD;			//stereo cameras in average point fit measurement mode&#xD;			case Vars.cmd_s_cam_avg_pt_fit: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_enb_s_cam_circ_fit = false;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				break;		&#xD;&#xD;&#xD;			case Vars.cmd_dia_rect_ROI_threshold_change: &#xD;				ss = ss[1];&#xD;&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_dia_rect_ROI_threshold = ToNumber(ss);&#xD;					Vars.dia_rect_thr = 255*Vars.param_dia_rect_ROI_threshold/100;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;&#xD;				break;&#xD;&#xD;			case Vars.cmd_dia_ROI_thr_rel_type: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_enable_threshold_by_persent = true;&#xD;				Vars.output = &quot;ok&quot;;&#xD;					&#xD;				break;&#xD;			case Vars.cmd_dia_ROI_thr_abs_type: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_enable_threshold_by_persent = false;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				&#xD;				break;			&#xD;&#xD;			case Vars.cmd_dip_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 3, Vars.inputNumbers)) {&#xD;					ConvertDippingBoundBoxToROICoords(Vars.inputNumbers, Vars.param_dip_ROI_coord);	&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;&#xD;				break;&#xD;			case Vars.cmd_dip_ROI_threshold_change: &#xD;				ss = ss[1];&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_dip_ROI_threshold= ToNumber(ss);&#xD;					Vars.dip_thr = 255*Vars.param_dip_ROI_threshold/100;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				&#xD;				break;&#xD;			case Vars.cmd_melt_ROI_coord_change: &#xD;				if (StringsToNumbersArray(ss[1], 6, Vars.inputNumbers)) { &#xD;					ConvertMeltingBoundBoxToROICoords(Vars.inputNumbers, Vars.param_melt_ROI_coord);&#xD;					ConvertMeltingBoundBox_2_ToROICoords(Vars.inputNumbers, Vars.param_melt_ROI_2_coord);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;&#xD;				break;&#xD;			case Vars.cmd_melt_ROI_threshold_change: &#xD;				ss = ss[1];&#xD;				if (isNumber(ss)) {&#xD;					Vars.param_melt_ROI_threshold= ToNumber(ss);&#xD;					Vars.melt_thr = 255*Vars.param_melt_ROI_threshold/100;&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;				&#xD;				break;&#xD;			case Vars.cmd_image_acquisition_off: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_MeasurementEnabled = false;&#xD;				Vars.output = &quot;ok&quot;;&#xD;	&#xD;				break;&#xD;			case Vars.cmd_image_acquisition_on: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.param_MeasurementEnabled = true;&#xD;				Vars.output = &quot;ok&quot;;&#xD;	&#xD;				break;&#xD;			case Vars.cmd_image_acquisition_get: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;	&#xD;				break;&#xD;			case Vars.cmd_get_version: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;	&#xD;				break;&#xD;			case Vars.cmd_SetRefreshRate:&#xD;				ss = ss[1];&#xD;				if (isNumber(ss)) {&#xD;					Vars.refresh_rate= ToNumber(ss);&#xD;					Vars.telegram_type = cmd;&#xD;					Vars.output = &quot;ok&quot;;&#xD;				}&#xD;	&#xD;				break;&#xD;			case Vars.cmd_GetRefreshRate: &#xD;				Vars.telegram_type = cmd;&#xD;				Vars.output = &quot;ok&quot;;&#xD;				&#xD;				break;&#xD;				&#xD;			default:&#xD;				Vars.telegram_type = &quot;err_unk&quot;;&#xD;				Vars.output = cmd;&#xD;			}	&#xD;		}&#xD;		catch(error) {&#xD;			Vars.telegram_type = &quot;err_exc&quot;;&#xD;			Vars.output = error.toString();&#xD;		}&#xD;	}&#xD;}&#xD;finally {&#xD;	Trace(&apos;telegram_type &apos; + Vars.telegram_type + &apos; output &apos; + Vars.output);&#xD;}&#xD;&#xD;&#xD;/*&#xD;re2 = /=/g;&#xD;VEngine.Reporter(src.match(re2));&#xD;while ((arr = re2.exec(src)) != null) {&#xD;   VEngine.Reporter(arr.index + &quot;-&quot; + arr.lastIndex + &quot;\t&quot; + arr);&#xD;}&#xD;&#xD;re = new RegExp(src, &quot;\n&quot;);&#xD;VEngine.Reporter(&apos;ku-ku&apos;);&#xD;&#xD;while ((arr = re.exec(src)) != null) {&#xD;VEngine.Reporter(&apos;ku-ku&apos;);&#xD;   VEngine.Reporter(arr.index + &quot;-&quot; + arr.lastIndex + &quot;\t&quot; + arr);&#xD;}&#xD;;&#xD;*/">
<Inputs
/>
<Outputs
/>
<Params
/>
</Instruction>
