}
QPlainTextEdit{
	background-color: transparent;
	border: 0px solid rgb(70, 80, 110);
}

QFrame {
	background-color: transparent;
	border: 0px solid rgb(70, 80, 110);
}

QGroupBox{
	background-color: transparent;
	border: 1px solid rgb(70, 80, 110);
	border-radius: 4px;
    padding-top: 12px;
}


QSplitter::handle {
    /* background-color: rgb(255, 170, 0);   */
	/* background-color: rgb(70, 80, 110); */
	border: 1px solid rgb(70, 80, 110);
}

QTabWidget::pane{
	border: 0px solid rgb(70, 80, 110);
	background-color: transparent;
}
QTabBar::tab {
	border: 0;
	background-color: transparent;
	padding: 5px;
}

#detailsTabs::pane {
	border: 1px solid rgb(70, 80, 110);
	background-color: rgb(33, 37, 43);
}
#detailsTabs QTabBar::tab {
	min-height: 22px;
	min-width: 64px;
	padding: 4px 4px;
	margin-right: 2px;
	color: white;
	background-color: rgb(70, 80, 110);
	border: 1px solid rgb(70, 80, 110);
	border-bottom: 0px;
}
#detailsTabs QTabBar::tab:hover {
	background-color: rgb(70, 80, 110);
	border: 1px solid rgb(33, 37, 43);
	border-bottom: 0px;
}
#detailsTabs QTabBar::tab:selected {
	background-color: rgb(54, 138, 90);
	border-color: rgb(78, 170, 112);
	color: white;
}
